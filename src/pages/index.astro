---

<PageLayout meta={{ title: "Home" }}>
	<section class="index-content" id="about">
		<div class="flex items-center gap-4">
			<Image
				priority
				alt="Portrait of Chenfei Liao"
				class="h-20 w-20 shrink-0 rounded-full object-cover"
				height={320}
				src="/assets/chenfei.jpg"
				width={320}
			/>
			<div>
				<h1 class="text-accent-2 text-xl font-semibold wrap-break-word">Chenfei Liao</h1>
				<div>M.Phil. Student in Artificial Intelligence</div>
				<div>The Hong Kong University of Science and Technology (Guangzhou)</div>
				<div class="text-gray-600 dark:text-gray-400">cliao127@connect.hkust-gz.edu.cn</div>
			</div>
		</div>
		<hr class="index-divider mt-4" />
		<div class="mt-4">
			<p>
				I am an M.Phil. student in the
				<a
					class="typefolio-link-lighter"
					href="https://www.hkust-gz.edu.cn/academics/hubs-and-thrust-areas/information-hub/"
					target="_blank">Red Bird Program (Artificial Intelligence)</a
				>
				at
				<a class="typefolio-link-lighter" href="https://www.hkust-gz.edu.cn/" target="_blank"
					>the Hong Kong University of Science and Technology (Guangzhou)</a
				>, supervised by
				<a class="typefolio-link-lighter" href="https://xuminghu.github.io/" target="_blank"
					>Prof. Xuming Hu</a
				>
				and
				<a class="typefolio-link-lighter" href="https://www.cse.ust.hk/~yqsong/" target="_blank"
					>Prof. Yangqiu Song</a
				>. I am currently a remote research intern at
				<a class="typefolio-link-lighter" href="https://www.kaust.edu.sa/en/" target="_blank"
					>KAUST</a
				>
				with
				<a class="typefolio-link-lighter" href="https://www.mohamed-elhoseiny.com/" target="_blank"
					>Prof. Mohamed Elhoseiny</a
				>.
			</p>
			<p>
				My research focuses on the panoramic world, exploring the potential of panoramas as a new
				bridge towards real embodied intelligence and world models. I also work on robust
				multi-modal perception and efficient MLLMs. I work closely with
				<a class="typefolio-link-lighter" href="https://zhengxujosh.github.io/" target="_blank"
					>Prof. Xu Zheng</a
				>
				(GBU),
				<a
					class="typefolio-link-lighter"
					href="http://www.zhanglinfeng.tech/index.html"
					target="_blank">Prof. Linfeng Zhang</a
				>
				(SJTU), and
				<a class="typefolio-link-lighter" href="https://disi.unitn.it/~sebe/" target="_blank"
					>Prof. Nicu Sebe</a
				>
				(UniTrento).
			</p>
			<p class="text-accent font-semibold">I am looking for a PhD position starting in 2027.</p>
			<p class="flex flex-wrap items-center gap-x-1">
				<span class="me-1">Find me on</span>
				{
					socialLinks.map((link) => (
						<InlineIconLink
							href={link.href}
							icon={link.icon}
							label={link.label}
							title={link.label}
							width="1.75em"
							height="1.75em"
							target="_blank"
						/>
					))
				}
			</p>
		</div>
	</section>

	<WhatsNewTimeline items={whatsNewItems} />

	<section class="mt-8" id="publications">
		<h2 class="title mb-1 text-xl">Selected Publications</h2>
		<p class="mb-4 text-xs text-gray-600 dark:text-gray-400">
			C = Conference, P = Preprint, T = Technical Report, * = Equal Contribution, † = Project Lead
		</p>
		<div class="space-y-2">
			{
				publications.map((pub) => (
					<p data-pub>
						[{pub.id}]{" "}
						{pub.authors.slice(0, VISIBLE_AUTHORS).map((author, i) => (
							<>
								{i > 0 ? ", " : ""}
								{isMe(author) ? <span class="font-semibold">{author}</span> : author}
							</>
						))}{pub.authors.length > VISIBLE_AUTHORS && (
							<><span class="hidden" data-pub-more>{pub.authors.slice(VISIBLE_AUTHORS).map((author) => (
										<>
											{", "}
											{isMe(author) ? <span class="font-semibold">{author}</span> : author}
										</>
									))}
								</span>
								<button
									aria-expanded="false"
									class="text-accent ms-1 cursor-pointer text-xs font-semibold hover:underline"
									data-collapsed-label={`… +${pub.authors.length - VISIBLE_AUTHORS} more`}
									data-expanded-label="show less"
									data-pub-toggle
									type="button"
								>
									… +{pub.authors.length - VISIBLE_AUTHORS} more
								</button></>
						)}{`, "${pub.title}," in `}
						<em>{pub.venue}</em>, {pub.year}.
						{pub.badges?.map((badge) => (
							<span class="text-accent ms-1 text-xs font-semibold">[{badge}]</span>
						))}
						{pub.links.map((link) => (
							<a class="typefolio-link-lighter ms-1 font-medium" href={link.href} target="_blank">
								[{link.label}]
							</a>
						))}
					</p>
				))
			}
		</div>
	</section>

	<section class="mt-8" id="education">
		<h2 class="title mb-4 text-xl">Education</h2>
		<ul class="space-y-4" role="list">
			{
				education.map((entry) => (
					<li class="grid grid-cols-[2.25rem_minmax(0,1fr)] gap-x-3">
						<img
							alt=""
							aria-hidden="true"
							class="mt-0.5 h-9 w-9 rounded-full object-contain bg-white ring-1 ring-black/5 dark:ring-white/10"
							height={72}
							loading="lazy"
							src={entry.logo}
							width={72}
						/>
						<div>
							<div class="flex flex-wrap items-baseline justify-between gap-x-4">
								<span class="text-accent-2 font-semibold">
									{entry.orgHref ? (
										<a class="typefolio-link-lighter" href={entry.orgHref} target="_blank">
											{entry.org}
										</a>
									) : (
										entry.org
									)}
								</span>
								<span class="text-xs font-semibold text-gray-600 dark:text-gray-400">{entry.date}</span>
							</div>
							<div class="flex flex-wrap items-baseline justify-between gap-x-4">
								<span>{entry.role}</span>
								<span class="text-xs text-gray-600 dark:text-gray-400">{entry.location}</span>
							</div>
							{entry.notes?.map((note) => (
								<div class="text-gray-600 dark:text-gray-400">· {note}</div>
							))}
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-8" id="experience">
		<h2 class="title mb-4 text-xl">Experience</h2>
		<ul class="space-y-4" role="list">
			{
				experience.map((entry) => (
					<li class="grid grid-cols-[2.25rem_minmax(0,1fr)] gap-x-3">
						<img
							alt=""
							aria-hidden="true"
							class="mt-0.5 h-9 w-9 rounded-full object-contain bg-white ring-1 ring-black/5 dark:ring-white/10"
							height={72}
							loading="lazy"
							src={entry.logo}
							width={72}
						/>
						<div>
							<div class="flex flex-wrap items-baseline justify-between gap-x-4">
								<span class="text-accent-2 font-semibold">
									{entry.orgHref ? (
										<a class="typefolio-link-lighter" href={entry.orgHref} target="_blank">
											{entry.org}
										</a>
									) : (
										entry.org
									)}
								</span>
								<span class="text-xs font-semibold text-gray-600 dark:text-gray-400">{entry.date}</span>
							</div>
							<div class="flex flex-wrap items-baseline justify-between gap-x-4">
								<span>{entry.role}</span>
								<span class="text-xs text-gray-600 dark:text-gray-400">{entry.location}</span>
							</div>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-8" id="awards">
		<h2 class="title mb-4 text-xl">Awards</h2>
		<ul class="space-y-1" role="list">
			{
				awards.map((award) => (
					<li class="grid grid-cols-[3.5rem_minmax(0,1fr)]">
						<span class="font-semibold text-gray-600 dark:text-gray-400">{award.year}</span>
						<span>{award.title}</span>
					</li>
				))
			}
		</ul>
	</section>

	<section class="index-content mt-8" id="services">
		<h2 class="title mb-4 text-xl">Academic Services</h2>
		{
			services.map((group) => (
				<div class="mb-3">
					<div class="text-accent-2 font-semibold">{group.title}</div>
					<ul class="list-disc" role="list">
						{group.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			))
		}
	</section>

	<script>
		declare global {
			interface Window {
				__pubToggleBound?: boolean;
			}
		}

		if (!window.__pubToggleBound) {
			window.__pubToggleBound = true;
			document.addEventListener("click", (event) => {
				if (!(event.target instanceof Element)) return;
				const button = event.target.closest<HTMLButtonElement>("[data-pub-toggle]");
				if (!button) return;

				const more = button.closest("[data-pub]")?.querySelector("[data-pub-more]");
				if (!more) return;

				const expanded = button.getAttribute("aria-expanded") === "true";
				more.classList.toggle("hidden", expanded);
				button.setAttribute("aria-expanded", String(!expanded));
				button.textContent =
					(expanded ? button.dataset.collapsedLabel : button.dataset.expandedLabel) ?? "";
			});
		}
	</script>
</PageLayout>